    if hideConn then hideConn:Disconnect() end
    hideConn=ch.DescendantAdded:Connect(function(d)
        if (d:IsA("BasePart") or d:IsA("Decal")) and d.Name~="HumanoidRootPart" and not d:FindFirstAncestorOfClass("Tool") and d:GetAttribute("VV_Transparency")==nil then d:SetAttribute("VV_Transparency",d.Transparency); d.Transparency=1 end
    end)
