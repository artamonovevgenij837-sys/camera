local function updateItem(A)
    if not itemReg or not A.rightArm then return end
    local cf=A.rightArm*itemReg.tilt
    for _,d in ipairs(itemReg.parts) do
        d.p.Transparency=0
        d.p.CFrame=cf*d.offset
    end
end

