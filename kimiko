local function wipeWorld()
    for _,v in ipairs(Lighting:GetChildren()) do if v.Name:sub(1,3)=="VV_" and v:IsA("Sky") or v.Name:sub(1,3)=="VV_" and v:IsA("Atmosphere") then v:Destroy() end end
