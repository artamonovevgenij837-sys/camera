build=function(tab)
    currentTab=tab or currentTab; clearColumns(); local a,b,c=column(),column(),column()
    if currentTab=="Characters" then charactersTab(a,b,c) elseif currentTab=="Cosmetics" then cosmeticsTab(a,b,c) elseif currentTab=="Items" then itemsTab(a,b,c) elseif currentTab=="Shaders" then shadersTab(a,b,c) elseif currentTab=="World" then worldTab(a,b,c) elseif currentTab=="Settings" then settingsTab(a,b,c) end
    for n,t in pairs(tabButtons) do t.TextColor3=n==currentTab and C.accent or C.muted end
end
for _,name in ipairs({"Characters","Cosmetics","Items","Shaders","World","Settings"}) do
    local t=new("TextButton",{Name=name,Size=UDim2.fromOffset(96,39),BackgroundTransparency=1,Text=name,TextSize=12,Font=Enum.Font.GothamBold,TextColor3=C.muted,BorderSizePixel=0},tabs); tabButtons[name]=t
    t.MouseButton1Click:Connect(function() build(name) end)
end
build("Characters")
toggleOpen.MouseButton1Click:Connect(function() setOpen(true) end)
UIS.InputBegan:Connect(function(i,gp) if not gp and i.KeyCode==Enum.KeyCode.RightShift then setOpen(not main.Visible) end end)
local dragging,dragStart,origin
header.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.Touch or i.UserInputType==Enum.UserInputType.MouseButton1 then dragging=i; dragStart=i.Position; origin=main.Position end end)
UIS.InputChanged:Connect(function(i) if dragging and (i==dragging or i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then local d=i.Position-dragStart; main.Position=UDim2.new(origin.X.Scale,origin.X.Offset+d.X,origin.Y.Scale,origin.Y.Offset+d.Y) end end)
UIS.InputEnded:Connect(function(i) if dragging and (i==dragging or i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch) then dragging=nil end end)
local updateLoop=RunService.RenderStepped:Connect(function()
    local t=os.clock(); for _,c in pairs(cosmeticRegistry) do c.update(t) end; updateItem()
end)
_G.VV_Cleanup=function()
    if updateLoop then updateLoop:Disconnect() end
    if followConn then followConn:Disconnect() end; if hideConn then hideConn:Disconnect() end; if charConn then charConn:Disconnect() end
    if activeMorph then activeMorph:Destroy(); activeMorph=nil end
    restoreCharacter(player.Character)
    for _,c in pairs(cosmeticRegistry) do pcall(c.cleanup) end; cosmeticRegistry={}
    if itemRegistry then itemRegistry.model:Destroy(); itemRegistry=nil end
    for _,e in ipairs({bloom,colorFx,rays,dof,blur}) do e:Destroy() end
    wipeWorld(); restoreWorld()
    if gui then gui:Destroy() end
end
setOpen(true)
