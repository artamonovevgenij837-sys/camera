local function hideCharacter(ch)
    for _,d in ipairs(ch:GetDescendants()) do
        if (d:IsA("BasePart") or d:IsA("Decal")) and d.Name~="HumanoidRootPart" and not d:FindFirstAncestorOfClass("Tool") and d:GetAttribute("VV_Transparency")==nil then
            d:SetAttribute("VV_Transparency",d.Transparency); d.Transparency=1
